{# EasyAdmin index & detail display template for FileManagerField #}
{% set items = liveux_fm_normalize_field_items(field.value) %}
{% set eaOpts = (field.customOptions is defined and field.customOptions is not null) ? field.customOptions : null %}
{% set eaProfile = (eaOpts is not null and eaOpts.get('profile') is not empty) ? eaOpts.get('profile') : 'default' %}
{% set eaVolume = eaOpts is not null ? eaOpts.get('volume') : null %}
{% set eaPreview = (eaOpts is not null and eaOpts.get('preview') is not null) ? eaOpts.get('preview') : true %}

{% if items is empty %}
    <span class="badge bg-secondary">—</span>
{% else %}
    <div class="d-inline-flex flex-wrap align-items-center gap-1">
        {% for item in items|slice(0, 4) %}
            {% if item is not empty %}
                {% set info = liveux_fm_describe_field_item(item, eaProfile, eaVolume, eaPreview) %}
                {% if info.imgSrc is not empty and info.href is not empty %}
                    <a href="{{ info.href }}" target="_blank" rel="noopener noreferrer" title="{{ info.name }}">
                        <img src="{{ info.imgSrc }}" alt="{{ info.name }}" width="36" height="36" loading="lazy" class="rounded border object-fit-cover">
                    </a>
                {% elseif info.imgSrc is not empty %}
                    <span class="d-inline-block" title="{{ info.name }}">
                        <img src="{{ info.imgSrc }}" alt="{{ info.name }}" width="36" height="36" loading="lazy" class="rounded border object-fit-cover">
                    </span>
                {% elseif info.href is not empty %}
                    <a href="{{ info.href }}" target="_blank" rel="noopener noreferrer" class="badge bg-light text-dark border text-decoration-none">{{ info.name }}</a>
                {% else %}
                    <span class="badge bg-light text-dark border">{{ info.name }}</span>
                {% endif %}
            {% endif %}
        {% endfor %}
        {% if items|length > 4 %}
            <span class="badge bg-secondary">+{{ items|length - 4 }}</span>
        {% endif %}
    </div>
{% endif %}
